# Server Port
PORT=5000

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
# Example: mongodb+srv://admin:mySecurePassword123@cluster0.abcde.mongodb.net/fitscalez?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/fitscalez?retryWrites=true&w=majority

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5174

# Authentication Secrets
ACCESS_TOKEN_SECRET=fitscalez_access_secret_super_secure_key_2026
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=fitscalez_refresh_secret_super_secure_key_2026
REFRESH_TOKEN_EXPIRY=10d
